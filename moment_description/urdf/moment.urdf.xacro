<?xml version="1.0"?>
<!-- MOMENT: Mobile Manipulation Robot -->
<robot name="moment" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Local materials and robot components -->
  <xacro:include filename="$(find moment_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find moment_description)/urdf/turtlebot3_waffle_pi.urdf.xacro"/>
  <xacro:include filename="$(find moment_description)/urdf/open_manipulator_x.urdf.xacro"/>

  <!-- Mobile base -->
  <xacro:turtlebot3_waffle_pi prefix=""/>

  <!-- Mount the arm on the mobile base -->
  <joint name="base_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="-0.092 0.0 0.091" rpy="0 0 0"/>
  </joint>

  <!-- Robotic arm and gripper -->
  <xacro:open_manipulator_x prefix=""/>

</robot>
